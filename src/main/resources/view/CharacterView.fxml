<?fxml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.unpri.charactermanager.view.CharacterController"
            prefWidth="1100.0"
            prefHeight="720.0"
            style="-fx-background-color: #F3F6FC;">

    <!-- HEADER / TOP -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="18.0"
              style="-fx-background-color: #172554; -fx-padding: 24 30 24 30;">

            <VBox spacing="5.0">
                <Label text="CHARACTER MANAGER"
                       style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>

                <Label text="Kelola karakter game dalam satu dashboard"
                       style="-fx-text-fill: #CBD5E1; -fx-font-size: 13px;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="SPRINT 07  •  VERSION 0.7"
                   style="-fx-text-fill: #BFDBFE; -fx-font-size: 12px; -fx-font-weight: bold;"/>

        </HBox>
    </top>

    <!-- FORM / LEFT -->
    <left>
        <VBox prefWidth="300.0"
              spacing="16.0"
              style="-fx-background-color: white; -fx-padding: 24; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">

            <Label text="Tambah Karakter"
                   style="-fx-text-fill: #172554; -fx-font-size: 20px; -fx-font-weight: bold;"/>

            <Label text="Lengkapi data karakter di bawah ini."
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>

            <VBox spacing="7.0">
                <Label text="Nama Karakter"
                       style="-fx-text-fill: #334155; -fx-font-weight: bold;"/>

                <TextField fx:id="nameField"
                           promptText="Contoh: Arthur"
                           prefHeight="40.0"
                           style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #CBD5E1;"/>
            </VBox>

            <VBox spacing="7.0">
                <Label text="Level"
                       style="-fx-text-fill: #334155; -fx-font-weight: bold;"/>

                <TextField fx:id="levelField"
                           promptText="Masukkan level (1-99)"
                           prefHeight="40.0"
                           style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #CBD5E1;"/>
            </VBox>

            <VBox spacing="7.0">
                <Label text="Tipe Karakter"
                       style="-fx-text-fill: #334155; -fx-font-weight: bold;"/>

                <ComboBox fx:id="typeComboBox"
                          promptText="Pilih tipe karakter"
                          prefWidth="250.0"
                          prefHeight="40.0"/>
            </VBox>

            <Button text="＋  Simpan Karakter"
                    onAction="#handleSave"
                    maxWidth="Infinity"
                    prefHeight="42.0"
                    style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;"/>

            <Button text="Bersihkan Form"
                    onAction="#handleReset"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand;"/>

            <Separator/>

            <Label text="Panduan Tipe Karakter"
                   style="-fx-text-fill: #172554; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <VBox spacing="9.0">

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="⚔"
                           prefWidth="28.0"
                           style="-fx-font-size: 18px; -fx-text-fill: #DC2626;"/>

                    <VBox spacing="2.0">
                        <Label text="WARRIOR"
                               style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <Label text="Petarung jarak dekat"
                               style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="✦"
                           prefWidth="28.0"
                           style="-fx-font-size: 18px; -fx-text-fill: #7C3AED;"/>

                    <VBox spacing="2.0">
                        <Label text="MAGE"
                               style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <Label text="Pengguna kekuatan sihir"
                               style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="➶"
                           prefWidth="28.0"
                           style="-fx-font-size: 18px; -fx-text-fill: #059669;"/>

                    <VBox spacing="2.0">
                        <Label text="ARCHER"
                               style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <Label text="Penyerang jarak jauh"
                               style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="✚"
                           prefWidth="28.0"
                           style="-fx-font-size: 18px; -fx-text-fill: #D97706;"/>

                    <VBox spacing="2.0">
                        <Label text="HEALER"
                               style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <Label text="Pendukung dan penyembuh"
                               style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                    </VBox>
                </HBox>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Character Manager • JavaFX"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>

        </VBox>
    </left>

    <!-- MAIN CONTENT / CENTER -->
    <center>
        <VBox spacing="18.0"
              style="-fx-padding: 25;">

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4.0">
                    <Label text="Dashboard Karakter"
                           style="-fx-text-fill: #172554; -fx-font-size: 22px; -fx-font-weight: bold;"/>

                    <Label text="Ringkasan dan daftar karakter yang tersimpan"
                           style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="DAFTAR KARAKTER"
                       style="-fx-text-fill: #64748B; -fx-font-size: 10px; -fx-font-weight: bold;"/>

            </HBox>

            <!-- SUMMARY CARDS -->
            <HBox spacing="12.0">

                <VBox HBox.hgrow="ALWAYS"
                      spacing="8.0"
                      style="-fx-background-color: white; -fx-padding: 17; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">

                    <Label text="TOTAL KARAKTER"
                           style="-fx-text-fill: #64748B; -fx-font-size: 10px; -fx-font-weight: bold;"/>

                    <Label fx:id="totalLabel"
                           text="0"
                           style="-fx-text-fill: #1D4ED8; -fx-font-size: 26px; -fx-font-weight: bold;"/>

                </VBox>

                <VBox HBox.hgrow="ALWAYS"
                      spacing="8.0"
                      style="-fx-background-color: white; -fx-padding: 17; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">

                    <Label text="RATA-RATA LEVEL"
                           style="-fx-text-fill: #64748B; -fx-font-size: 10px; -fx-font-weight: bold;"/>

                    <Label fx:id="averageLabel"
                           text="0.0"
                           style="-fx-text-fill: #059669; -fx-font-size: 26px; -fx-font-weight: bold;"/>

                </VBox>

            </HBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="8.0">

                <Label text="Karakter Tersimpan"
                       style="-fx-text-fill: #172554; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Data diperbarui oleh aplikasi"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>

            </HBox>

            <!-- CHARACTER LIST -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">

                <content>
                    <VBox fx:id="characterList"
                          spacing="10.0"
                          style="-fx-background-color: transparent; -fx-padding: 3 5 8 3;"/>
                </content>

            </ScrollPane>

        </VBox>
    </center>

    <!-- STATUS / BOTTOM -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              spacing="10.0"
              style="-fx-background-color: white; -fx-padding: 13 25 13 25; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">

            <Label text="●"
                   style="-fx-text-fill: #16A34A; -fx-font-size: 11px;"/>

            <Label text="STATUS:"
                   style="-fx-text-fill: #64748B; -fx-font-size: 10px; -fx-font-weight: bold;"/>

            <Label fx:id="statusLabel"
                   text="Aplikasi siap digunakan."
                   style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="UNPRI • CHARACTER MANAGER v0.7"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>

        </HBox>
    </bottom>

</BorderPane>
